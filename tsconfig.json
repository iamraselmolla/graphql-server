{
  "compilerOptions": {
    "target": "ES2020", // Suitable for modern Node.js
    "module": "CommonJS", // Node.js module system
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "allowJs": false,
    "outDir": "./dist", // Compiled files go here
    "rootDir": "./src", // Your source folder
    "strict": true, // Enable all strict type-checking
    "esModuleInterop": true, // Allows default imports from CommonJS
    "forceConsistentCasingInFileNames": true, // Avoid case-sensitive errors
    "skipLibCheck": true, // Skip checking declaration files
    "resolveJsonModule": true, // Allows importing .json files
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
